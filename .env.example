# SIEM++ Environment Configuration Template

# Server Port (default: 4000)
PORT=4000

# API Security Key (X-API-Key header)
API_KEY=siem-default-key-12345

# Data Retention in Days (0 to disable auto-cleanup, default: 90)
RETENTION_DAYS=90

# Auto load sample data on Vercel or cold start (true/false)
AUTO_LOAD_SAMPLES=true

# Syslog UDP Server Port (leave unset to disable Syslog listener)
# SYSLOG_PORT=514

# SMTP Notification Settings (optional for alert emails)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your-email@gmail.com
# SMTP_PASS=your-app-password
# SMTP_FROM=siem-alerts@yourdomain.com
# ALERT_RECIPIENTS=secops@yourdomain.com
