{
  "name": "siemplusplus",
  "version": "1.0.0",
  "description": "SIEM++ - a self-hosted mini SIEM: log ingestion, search, dashboards, detection rules, threat intel, and notifications.",
  "main": "server.js",
  "engines": {
    "node": ">=22.5.0"
  },
  "scripts": {
    "start": "node server.js",
    "dev": "node server.js"
  },
  "keywords": ["siem", "soc", "security", "log-analysis", "detection-rules", "threat-intel", "splunk"],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "chart.js": "^4.5.1",
    "express": "^5.2.1",
    "helmet": "^8.0.0",
    "cors": "^2.8.5",
    "express-rate-limit": "^7.4.0",
    "nodemailer": "^6.9.13",
    "ws": "^8.18.0",
    "multer": "^2.2.0"
  },
  "engines": {
    "node": ">=18.x"
  },
  "vercel": {
    "version": 2,
    "builds": [
      {
        "src": "server.js",
        "use": "@vercel/node",
        "config": { "includeFiles": ["src/**", "public/**", "sample-logs/**", "data/**"] }
      }
    ],
    "routes": [
      { "src": "/(.*)", "dest": "/server.js" }
    ]
  }
}
