{
  "version": 2,
  "builds": [
    {
      "src": "server.js",
      "use": "@vercel/node",
      "config": {
        "includeFiles": [
          "src/**",
          "public/**",
          "sample-logs/auth-syslog.log",
          "sample-logs/access-nginx.log",
          "sample-logs/eve.json",
          "sample-logs/winevents.json",
          "data/threatintel/**"
        ]
      }
    }
  ],
  "routes": [
    { "src": "/(.*)", "dest": "/server.js" }
  ],
  "env": {
    "API_KEY": "change-me-in-vercel-env",
    "RETENTION_DAYS": "30"
  }
}
